# Production config — cPanel "Setup Node.js App" > Environment variables.
# Either set these as environment variables (recommended) or copy this file
# to `.env` next to package.json and fill it in. NEVER commit real secrets.
#
# Generate secrets with:  openssl rand -hex 32   (run twice)

NODE_ENV=production

# Required — two DIFFERENT long random strings (>= 32 chars each).
# The app refuses to boot in production with missing/weak/equal values.
JWT_SECRET=PASTE_FIRST_RANDOM_HERE
CSRF_SECRET=PASTE_SECOND_RANDOM_HERE

# SQLite file. Relative paths resolve under ./prisma/ (prod.db is shipped
# pre-migrated). Prefer an absolute path outside the web root if your host
# allows it, e.g.  DATABASE_URL=file:/home/YOURUSER/app-data/prod.db
DATABASE_URL=file:./prod.db

# cPanel/Passenger injects PORT itself — leave this line alone.
# PORT=3001

# Your real domain(s), comma-separated, NO trailing slash.
# Example: ALLOWED_ORIGINS=https://azmon.example.ir
ALLOWED_ORIGINS=https://YOURDOMAIN

# --- auth cookies (production HTTPS) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# cPanel runs behind a proxy — keep true so rate-limit/audit IPs are real.
TRUST_PROXY=true

# Serve the built SPA from the same origin (first-party cookies). Keep 1.
CLIENT_DIST=1
