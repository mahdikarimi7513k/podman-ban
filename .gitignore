# secrets — never commit
.env

# local databases + backups + journals (anything sqlite under prisma/)
server/prisma/*.db*
server/tests/data/

# uploads (user content)
uploads/*

# agent workspace (local-only)
.agents/

# local lint plugin (not needed to build/run/test/deploy)
tools/

# local-only lint config (anti-slop plugin lives in tools/) + agent skill lockfile
.oxlintrc.json
skills-lock.json

# cPanel deploy bundle (regenerated by build; lives on disk + deploy.zip)
deploy/

# install output
node_modules/
client/dist/
client/android/
server/dist-server/
*.tsbuildinfo

# production deploy bundle: prod.db holds a REAL admin hash, zips are
# redundant binaries (git is the source archive) — never commit either
deploy/prisma/*.db*
*.zip
