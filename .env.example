# Copy to .env and fill in real values. NEVER commit .env.
# Production (cPanel): set these as environment variables instead.

# Required — long random strings (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret
CSRF_SECRET=change-me-to-another-long-random-secret

# SQLite file (server resolves relative to server/prisma/)
DATABASE_URL=file:./dev.db

PORT=3001

# Comma-separated origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,http://localhost,https://localhost

# --- auth cookies ---
# COOKIE_SECURE=true on HTTPS production (browsers drop Secure cookies on plain http).
# Leave unset/false for local http dev, otherwise login looks fine but every
# data request goes out cookieless and answers 401.
# COOKIE_SECURE=false
# SameSite mode: strict (web default) | lax | none (Capacitor APK only)
# COOKIE_SAMESITE=strict

# Set TRUST_PROXY=true only behind a real proxy (Caddy/cPanel) that sets X-Forwarded-For
# TRUST_PROXY=false

# --- OAuth social login (Google + GitHub). Leave ALL unset to keep it OFF
# (the app simply hides the buttons; nothing else changes). When enabling,
# register these redirect URIs at the provider consoles:
#   https://YOURDOMAIN/api/auth/oauth/google/callback
#   https://YOURDOMAIN/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional: public base URL (defaults to the request host — set it if the
# app sits behind a path/prefix proxy that rewrites Host).
# OAUTH_BASE_URL=https://YOURDOMAIN
# Optional: custom scheme for the APK return hop (must equal the APK
# app_id used at dispatch, lowercase).
# OAUTH_APP_SCHEME=ir.payamcoder.podmanban
